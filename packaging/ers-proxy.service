[Unit]
Description=ERS-Proxy – portal and EDM compatibility proxy for network devices
Documentation=https://github.com/lan-dot-party/ERS-Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ers-proxy
Group=ers-proxy
Environment=ERSPROXY_CONFIG=/etc/ers-proxy/config.yaml
EnvironmentFile=-/etc/ers-proxy/ers-proxy.env
ExecStart=/usr/bin/ers-proxy server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# /var/lib/ers-proxy, created and owned by the service user.
StateDirectory=ers-proxy
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ers-proxy
UMask=0077

# ERS-Proxy needs the network (to the browsers and the devices), its state
# directory and read access to its configuration. Everything else is closed off.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/ers-proxy

[Install]
WantedBy=multi-user.target
